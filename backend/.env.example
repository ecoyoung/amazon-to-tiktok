# Required: DeepSeek API key.
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Required: Keepa API key.
KEEPA_API_KEY=your-keepa-key

# Optional fallback for legacy/local setups. Leave empty when using KEEPA_API_KEY.
KEEPA_KEY_FILE=

# Optional: defaults normally do not need changing.
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
